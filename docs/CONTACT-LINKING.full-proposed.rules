rules_version = '2';
service cloud.firestore {  
match /databases/{database}/documents {    
match /trainers/{userId} {      
allow read, write: if request.auth != null                         
&& request.auth.uid == userId;    
}    
// First cloud test: two new documents, create only.    
match /fitppTestWorkspaces/synthetic-v1/states/{documentId} {      
function testOwner() {        
return database == '(default)'          
&& request.auth != null          
&& request.auth.uid == 'lLlMAetSG1aEeJSeBl4F4ypydEh2';      
}      
allow get: if testOwner()        
&& documentId in ['main', 'bookings'];      
allow create: if testOwner()        
&& documentId == 'bookings'        
&& request.resource.data.ownerUid == request.auth.uid        
&& request.resource.data.datasetId == 'synthetic-v1'        
&& request.resource.data.schemaVersion == 1        
&& (documentId != 'bookings' || (          
request.resource.data.keys().hasOnly([            
'ownerUid', 'datasetId', 'schemaVersion', 'entries'          
])          
&& request.resource.data.entries is map        
));    
}    
function maxTestOwner() {return database == '(default)' && request.auth != null && request.auth.uid == 'lLlMAetSG1aEeJSeBl4F4ypydEh2';}  
match /fitppTestWorkspaces/synthetic-v1/states/bookings {   
allow update: if maxTestOwner()    
&& resource.data.ownerUid == request.auth.uid && resource.data.datasetId == 'synthetic-v1' && resource.data.schemaVersion == 1    
&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries'])    
&& request.resource.data.entries is map && request.resource.data.entries.size() <= 500    
&& request.resource.data.entries.values().hasOnly([true])    
&& getAfter(/databases/$(database)/documents/fitppTestWorkspaces/synthetic-v1/states/bookingClock).data.revision == get(/databases/$(database)/documents/fitppTestWorkspaces/synthetic-v1/states/bookingClock).data.revision + 1    
&& request.resource.data.entries.diff(resource.data.entries).affectedKeys().hasOnly([getAfter(/databases/$(database)/documents/fitppTestWorkspaces/synthetic-v1/states/bookingClock).data.key])    
&& request.resource.data.entries.get(getAfter(/databases/$(database)/documents/fitppTestWorkspaces/synthetic-v1/states/bookingClock).data.key,false) == getAfter(/databases/$(database)/documents/fitppTestWorkspaces/synthetic-v1/states/bookingClock).data.booked;  
}  
match /fitppTestWorkspaces/synthetic-v1/states/bookingClock {   
allow get: if maxTestOwner();   
allow create: if maxTestOwner() && request.resource.data.keys().hasOnly(['revision','key','booked']) && request.resource.data.revision == 0 && request.resource.data.key == '' && request.resource.data.booked == false;   
allow update: if maxTestOwner() && request.resource.data.keys().hasOnly(['revision','key','booked']) && request.resource.data.revision == resource.data.revision+1 && request.resource.data.key is string && request.resource.data.booked is bool;  
}  
match /fitppTestWorkspaces/synthetic-v1/{kind}/{id} {   
allow get, create: if maxTestOwner() && id.matches('^[a-f0-9]{64}$') && kind in ['maxBindings','maxClientBindings','maxPolls','maxEvents'];   
allow get, create, update: if maxTestOwner() && id.matches('^[a-f0-9]{64}$') && kind == 'bookingVersions';  
}
match /fitppTestWorkspaces/synthetic-v1/states/main {
allow update: if maxTestOwner()
&& resource.data.ownerUid == request.auth.uid
&& resource.data.datasetId == 'synthetic-v1'
&& resource.data.schemaVersion == 1
&& request.resource.data.ownerUid == resource.data.ownerUid
&& request.resource.data.datasetId == 'synthetic-v1'
&& request.resource.data.schemaVersion == 1
&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clients','workouts','visits','visitOps','attendance','attendanceOps','finances','attendanceRevision','attendanceReceipts'])
&& request.resource.data.attendanceRevision == resource.data.get('attendanceRevision',0)+1
&& request.resource.data.attendanceReceipts is map
&& request.resource.data.attendanceReceipts.size() <= 500;
}
match /fitppTestWorkspaces/synthetic-v1/states/main {
allow update: if maxTestOwner()
&& resource.data.ownerUid == request.auth.uid
&& resource.data.datasetId == 'synthetic-v1' && resource.data.schemaVersion == 1
&& request.resource.data.ownerUid == resource.data.ownerUid
&& request.resource.data.datasetId == resource.data.datasetId
&& request.resource.data.schemaVersion == resource.data.schemaVersion
&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clients','workouts','visits','visitOps','attendance','attendanceOps','finances','rentMonths','legacyLinks','legacySources','pricingSettings','taxPayments','_fitppRevision','mutationReceipts'])
&& request.resource.data._fitppRevision == resource.data.get('_fitppRevision',0)+1
&& request.resource.data.clients is list && request.resource.data.clients.size() <= 500
&& request.resource.data.mutationReceipts is map
&& request.resource.data.mutationReceipts.size() == resource.data.get('mutationReceipts',{}).size()+1
&& request.resource.data.mutationReceipts.size() <= 500
&& request.resource.data.mutationReceipts.diff(resource.data.get('mutationReceipts',{})).removedKeys().size() == 0
&& request.resource.data.mutationReceipts.diff(resource.data.get('mutationReceipts',{})).changedKeys().size() == 0;
}

// Replace only the existing notificationBindings/training-test match block.
// Requires the existing maxTestOwner() helper; no production paths are changed.
match /fitppTestWorkspaces/synthetic-v1/notificationBindings/training-test {
  function rowOK(b) {
    return b is map
      && b.keys().hasOnly(['clientId','maxUserId','maxChatId','notificationsEnabled','recoverNotifications'])
      && b.clientId in ['demo-client-1','demo-client-2','demo-client-3','demo-client-4']
      && b.maxUserId is int && b.maxUserId > 0
      && b.maxChatId is int && b.maxChatId > 0
      && b.notificationsEnabled is bool
      && b.get('recoverNotifications',false) is bool;
  }
  function distinct(rows,i,j) {
    return rows.size() <= j || (rows[i].clientId != rows[j].clientId
      && rows[i].maxUserId != rows[j].maxUserId && rows[i].maxChatId != rows[j].maxChatId);
  }
  function registryOK(d) {
    let rows=d.bindings;
    return d.keys().hasOnly(['version','botId','bindings'])
      && d.version == 1 && d.botId == 131384398
      && rows is list && rows.size() >= 1 && rows.size() <= 4
      && rowOK(rows[0]) && (rows.size() < 2 || rowOK(rows[1]))
      && (rows.size() < 3 || rowOK(rows[2])) && (rows.size() < 4 || rowOK(rows[3]))
      && distinct(rows,0,1) && distinct(rows,0,2) && distinct(rows,0,3)
      && distinct(rows,1,2) && distinct(rows,1,3) && distinct(rows,2,3);
  }
  function preserved(before,after,i) {
    return before.size() <= i || after[i] == before[i]
      || (after[i].diff(before[i]).affectedKeys().hasOnly(['notificationsEnabled','recoverNotifications'])
        && after[i].notificationsEnabled == true && after[i].recoverNotifications == true);
  }
  allow get: if maxTestOwner();
  allow create: if maxTestOwner() && registryOK(request.resource.data)
    && request.resource.data.bindings.size() == 1
    && request.resource.data.bindings[0].notificationsEnabled == true
    && request.resource.data.bindings[0].recoverNotifications == true;
  allow update: if maxTestOwner() && registryOK(request.resource.data)
    && resource.data.version == 1 && resource.data.botId == 131384398
    && resource.data.bindings is list && resource.data.bindings.size() >= 1 && resource.data.bindings.size() <= 4
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bindings'])
    && request.resource.data.bindings.size() >= resource.data.bindings.size()
    && request.resource.data.bindings.size() <= resource.data.bindings.size()+1
    && preserved(resource.data.bindings,request.resource.data.bindings,0)
    && preserved(resource.data.bindings,request.resource.data.bindings,1)
    && preserved(resource.data.bindings,request.resource.data.bindings,2)
    && preserved(resource.data.bindings,request.resource.data.bindings,3);
  allow list, delete: if false;
}
// Training Test — автопостинг, отдельное хранилище
match /trainingTestAutopostBots/{botId}/polls/{date} {
  function trainingTestAuth() {
    return request.auth != null
      && request.auth.uid == 'lLlMAetSG1aEeJSeBl4F4ypydEh2'
      && botId.matches('^[1-9][0-9]*$')
      && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
  }

  allow get: if trainingTestAuth();
  allow list, delete: if false;

  allow create, update: if trainingTestAuth()
    && request.resource.data.version == 1
    && request.resource.data.botId == botId
    && request.resource.data.chat == '-80345864298680'
    && request.resource.data.date == date
    && request.resource.data.status in [
      'reserved', 'published', 'uncertain', 'external'
    ];

  match /events/{eventId} {
    allow get: if trainingTestAuth()
      && eventId.matches('^[a-f0-9]{64}$');

    allow create: if trainingTestAuth()
      && eventId.matches('^[a-f0-9]{64}$')
      && request.resource.data.keys().hasOnly(['digest', 'at'])
      && request.resource.data.digest is string
      && request.resource.data.at is int;

    allow list, update, delete: if false;
  }
}
}
}
