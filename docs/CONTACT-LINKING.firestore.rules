// Replace only the existing notificationBindings/training-test match block.
// Requires the existing maxTestOwner() helper; no production paths are changed.
match /fitppTestWorkspaces/synthetic-v1/notificationBindings/training-test {
  function rowOK(b) {
    return b is map
      && b.keys().hasOnly(['clientId','maxUserId','maxChatId','notificationsEnabled','recoverNotifications'])
      && b.clientId in ['demo-client-1','demo-client-2','demo-client-3','demo-client-4']
      && b.maxUserId is int && b.maxUserId > 0
      && b.maxChatId is int && b.maxChatId > 0
      && b.notificationsEnabled is bool
      && b.get('recoverNotifications',false) is bool;
  }
  function distinct(rows,i,j) {
    return rows.size() <= j || (rows[i].clientId != rows[j].clientId
      && rows[i].maxUserId != rows[j].maxUserId && rows[i].maxChatId != rows[j].maxChatId);
  }
  function registryOK(d) {
    let rows=d.bindings;
    return d.keys().hasOnly(['version','botId','bindings'])
      && d.version == 1 && d.botId == 131384398
      && rows is list && rows.size() >= 1 && rows.size() <= 4
      && rowOK(rows[0]) && (rows.size() < 2 || rowOK(rows[1]))
      && (rows.size() < 3 || rowOK(rows[2])) && (rows.size() < 4 || rowOK(rows[3]))
      && distinct(rows,0,1) && distinct(rows,0,2) && distinct(rows,0,3)
      && distinct(rows,1,2) && distinct(rows,1,3) && distinct(rows,2,3);
  }
  function preserved(before,after,i) {
    return before.size() <= i || after[i] == before[i]
      || (after[i].diff(before[i]).affectedKeys().hasOnly(['notificationsEnabled','recoverNotifications'])
        && after[i].notificationsEnabled == true && after[i].recoverNotifications == true);
  }
  allow get: if maxTestOwner();
  allow create: if maxTestOwner() && registryOK(request.resource.data)
    && request.resource.data.bindings.size() == 1
    && request.resource.data.bindings[0].notificationsEnabled == true
    && request.resource.data.bindings[0].recoverNotifications == true;
  allow update: if maxTestOwner() && registryOK(request.resource.data)
    && resource.data.version == 1 && resource.data.botId == 131384398
    && resource.data.bindings is list && resource.data.bindings.size() >= 1 && resource.data.bindings.size() <= 4
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bindings'])
    && request.resource.data.bindings.size() >= resource.data.bindings.size()
    && request.resource.data.bindings.size() <= resource.data.bindings.size()+1
    && preserved(resource.data.bindings,request.resource.data.bindings,0)
    && preserved(resource.data.bindings,request.resource.data.bindings,1)
    && preserved(resource.data.bindings,request.resource.data.bindings,2)
    && preserved(resource.data.bindings,request.resource.data.bindings,3);
  allow list, delete: if false;
}
